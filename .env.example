# ──────────────────────────────────────────────
# NodeMap — environment variables
# Copy this to .env and fill in your values.
# ──────────────────────────────────────────────

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# AI providers — set the one you want to use.
# The active provider is configured in Settings → AI Provider inside the app.
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=

# Optional path overrides (defaults shown — only needed for custom setups)
# DATA_DIR=/absolute/path/to/data       # where nodemap.db lives
# UPLOADS_DIR=/absolute/path/to/uploads # extracted repo files
# STATIC_DIR=/absolute/path/to/public   # production: built Vite files

# Dev only — CORS origin for the Vite dev server
CORS_ORIGIN=http://localhost:5173
